# Copy to .env and set real values before starting either compose stack.
# Both stacks refuse to start if these are unset, rather than falling back
# to a password published in this repository.

# Password for the unprivileged "writefreely" database user, which is the
# account the application connects as. Rather than copying the value into
# config.ini, reference it there:
#
#   [database]
#   password = ${MYSQL_PASSWORD}
#
# See "Keeping secrets out of config.ini" in docs/docker.md.
MYSQL_PASSWORD=

# MariaDB root password. Used only for administration, never by the app.
MYSQL_ROOT_PASSWORD=

# Container timezone. Both stacks.
TZ=Etc/UTC

# The user and group both containers run as, and therefore the ownership
# of everything they write: ./data and ./dbdata. Set these to your own ids
# so the bind mounts need no chown, and so you can read the files from the
# host without sudo:
#
#   echo "PUID=$(id -u)" >> .env
#   echo "PGID=$(id -g)" >> .env
#
# Both stacks. Defaults to 1000, the first user on most Linux hosts. On
# macOS, Docker Desktop remaps bind-mount ownership and these make no
# difference either way.
PUID=1000
PGID=1000

# Production stack only: the published image to run. Pin a release tag
# here instead of tracking latest.
#WRITEFREELY_IMAGE=ghcr.io/josephquigley/writefreely-wisp:v0.16.0

# Development stack only: the version string compiled into the binary.
# The build cannot read it from git in every context, so pass it here when
# you want the About page to report something specific.
#WRITEFREELY_VERSION=
